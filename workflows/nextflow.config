// Nextflow config — MVA Variant Prioritization Baseline (DSL2)
// Supports local + docker profiles, real VEP auto-detection, 80GB FASTQ QC

params {
    // Input
    vcf           = "data/WGS_EX2312012_HGWCNDSX7.vcf.gz"
    hpo           = "config/hpo_terms.yaml"
    config        = "config/example_config.yaml"
    fastq_pattern = "data/WGS_EX2312012_HGWCNDSX7_S16_L00*_R*_001.fastq.gz"
    // Reference
    reference     = "/data/references/GRCh38.fa"
    vep_cache     = "/data/vep_cache"   // if exists, real VEP runs; else pass-through mock
    fasta         = params.reference
    // Output
    outdir        = "results"
    // Options
    skip_qc       = false
    skip_trimming = true        // baseline: QC only, trimming optional for realignment path
    skip_annotation = false     // set true to skip VEP entirely (even mock)
    max_variants  = null        // for debugging: limit variants
}

process {
    executor = 'local'
    cpus = 4
    memory = '8 GB'
    errorStrategy = 'retry'
    maxRetries = 1
    // allow overwriting trace/report files
    withName: 'ANNOTATE' {
        cpus = 2
        memory = '4 GB'
    }
    withName: 'QC' {
        cpus = 2
        memory = '4 GB'
    }
    withName: 'PRIORITIZE' {
        cpus = 4
        memory = '12 GB'
    }
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

// Execution profiles
profiles {
    local {
        process.executor = 'local'
        docker.enabled = false
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ensemblorg/ensembl-vep:release_113.3'
    }
    // For HPC (SLURM/SGE) add later
}

manifest {
    name = 'mva-variant-prioritization'
    description = 'MVA Hackathon 2026 — Baseline Nextflow pipeline for variant prioritization'
    author = 'MVA Society / Sage Bionetworks Hackathon'
    version = '0.1.0-baseline'
    nextflowVersion = '!>=23.04.0'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}
